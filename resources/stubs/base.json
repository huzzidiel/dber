{
    "$schema": "./schema.json",
    "schema_version": 1,
    "name": "Laravel application",
    "database": "mysql",
    "tables": {
        "users": {
            "model": "App\\Models\\User",
            "description": "Application users.",
            "primary_key": [
                "id"
            ],
            "fields": {
                "id": {
                    "type": "bigint",
                    "unsigned": true,
                    "auto_increment": true
                },
                "name": {
                    "type": "string",
                    "length": 255
                },
                "email": {
                    "type": "string",
                    "length": 255,
                    "unique": true
                },
                "email_verified_at": {
                    "type": "timestamp",
                    "nullable": true
                },
                "password": {
                    "type": "string",
                    "length": 255
                },
                "remember_token": {
                    "type": "string",
                    "length": 100,
                    "nullable": true
                },
                "created_at": {
                    "type": "timestamp",
                    "nullable": true
                },
                "updated_at": {
                    "type": "timestamp",
                    "nullable": true
                },
                "deleted_at": {
                    "type": "timestamp",
                    "nullable": true
                }
            }
        },
        "roles": {
            "model": "Spatie\\Permission\\Models\\Role",
            "primary_key": [
                "id"
            ],
            "fields": {
                "id": {
                    "type": "bigint",
                    "unsigned": true,
                    "auto_increment": true
                },
                "name": {
                    "type": "string",
                    "length": 255
                },
                "guard_name": {
                    "type": "string",
                    "length": 255
                },
                "created_at": {
                    "type": "timestamp",
                    "nullable": true
                },
                "updated_at": {
                    "type": "timestamp",
                    "nullable": true
                }
            },
            "indexes": [
                {
                    "columns": [
                        "name",
                        "guard_name"
                    ],
                    "unique": true
                }
            ]
        },
        "permissions": {
            "model": "Spatie\\Permission\\Models\\Permission",
            "primary_key": [
                "id"
            ],
            "fields": {
                "id": {
                    "type": "bigint",
                    "unsigned": true,
                    "auto_increment": true
                },
                "name": {
                    "type": "string",
                    "length": 255
                },
                "guard_name": {
                    "type": "string",
                    "length": 255
                },
                "created_at": {
                    "type": "timestamp",
                    "nullable": true
                },
                "updated_at": {
                    "type": "timestamp",
                    "nullable": true
                }
            },
            "indexes": [
                {
                    "columns": [
                        "name",
                        "guard_name"
                    ],
                    "unique": true
                }
            ]
        },
        "model_has_roles": {
            "description": "Spatie polymorphic assignment of roles to any model.",
            "primary_key": [
                "role_id",
                "model_id",
                "model_type"
            ],
            "fields": {
                "role_id": {
                    "type": "bigint",
                    "unsigned": true,
                    "references": {
                        "table": "roles",
                        "field": "id",
                        "on_delete": "cascade"
                    }
                },
                "model_type": {
                    "type": "string",
                    "length": 255
                },
                "model_id": {
                    "type": "bigint",
                    "unsigned": true
                }
            },
            "indexes": [
                {
                    "columns": [
                        "model_id",
                        "model_type"
                    ]
                }
            ]
        },
        "model_has_permissions": {
            "description": "Spatie polymorphic assignment of permissions to any model.",
            "primary_key": [
                "permission_id",
                "model_id",
                "model_type"
            ],
            "fields": {
                "permission_id": {
                    "type": "bigint",
                    "unsigned": true,
                    "references": {
                        "table": "permissions",
                        "field": "id",
                        "on_delete": "cascade"
                    }
                },
                "model_type": {
                    "type": "string",
                    "length": 255
                },
                "model_id": {
                    "type": "bigint",
                    "unsigned": true
                }
            },
            "indexes": [
                {
                    "columns": [
                        "model_id",
                        "model_type"
                    ]
                }
            ]
        },
        "role_has_permissions": {
            "primary_key": [
                "permission_id",
                "role_id"
            ],
            "pivot": true,
            "fields": {
                "permission_id": {
                    "type": "bigint",
                    "unsigned": true,
                    "references": {
                        "table": "permissions",
                        "field": "id",
                        "on_delete": "cascade"
                    }
                },
                "role_id": {
                    "type": "bigint",
                    "unsigned": true,
                    "references": {
                        "table": "roles",
                        "field": "id",
                        "on_delete": "cascade"
                    }
                }
            }
        }
    }
}
