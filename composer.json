{
    "name": "huzzidiel/dber",
    "description": "Editable, AI-readable entity relationship diagrams for Laravel.",
    "keywords": [
        "laravel",
        "er-diagram",
        "database",
        "schema",
        "ai"
    ],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Huzzidiel Harrison"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "illuminate/console": "^10.0|^11.0|^12.0",
        "illuminate/contracts": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/routing": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/view": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "symfony/yaml": "^6.4|^7.0"
    },
    "suggest": {
        "symfony/yaml": "Required to read and write YAML schema files instead of JSON."
    },
    "autoload": {
        "psr-4": {
            "Huzzidiel\\Dber\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Huzzidiel\\Dber\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Huzzidiel\\Dber\\DberServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
